{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,

    "types": ["nativewind/types"],

    "baseUrl": ".",

    "paths": {
      "@/*": ["src/*"]
    },

    "ignoreDeprecations": "6.0"
  },

  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts",
    "declarations.d.ts"
  ]
}