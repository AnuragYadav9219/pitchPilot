# ============================================================
# VirtualMento - Root Git Ignore
# ============================================================


# ============================================================
# OS / SYSTEM FILES
# ============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# Linux
*~
.directory


# ============================================================
# ENVIRONMENT / SECRETS
# ============================================================

.env
.env.*
!.env.example
!.env.development.example
!.env.production.example
!.env.test.example

# Local secrets / credentials
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Firebase / service account credentials
service-account*.json
firebase-adminsdk*.json


# ============================================================
# NODE / JAVASCRIPT / TYPESCRIPT
# ============================================================

node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/
.pnpm-store/

# Package manager temporary files
*.tgz

# TypeScript build information
*.tsbuildinfo


# ============================================================
# WEB - REACT / VITE
# ============================================================

# Vite
.vite/

# Build output
dist/
build/

# Vite cache
node_modules/.vite/

# React / frontend cache
.cache/
.parcel-cache/


# ============================================================
# EXPO / REACT NATIVE
# ============================================================

.expo/
.expo-shared/

# Expo generated files
web-build/

# React Native Metro
.metro-health-check*
.metro/

# React Native / Expo logs
*.hprof

# Native build directories
apps/mobile/android/
apps/mobile/ios/

# Expo local state
apps/mobile/.expo/

# React Native generated files
*.orig.*
*.rej


# ============================================================
# ANDROID
# ============================================================

.gradle/
local.properties

# Android build output
**/build/
**/.cxx/

# Android Studio
captures/
.externalNativeBuild/


# ============================================================
# IOS / XCODE
# ============================================================

DerivedData/
*.xcuserstate
*.xcscmblueprint

# Xcode user-specific files
*.xcuserdatad

# Xcode build
build/


# ============================================================
# JAVA / SPRING BOOT / MAVEN
# ============================================================

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
.flattened-pom.xml

# Maven wrapper generated files
.mvn/timing.properties

# Spring Boot logs
spring.log

# Java compiled files
*.class

# Java archives
*.jar
*.war
*.ear

# Exception:
# Keep Maven wrapper JAR if you decide to commit it.
!.mvn/wrapper/maven-wrapper.jar


# ============================================================
# SPRING BOOT LOCAL CONFIG
# ============================================================

# Main local Spring Boot configuration
apps/backend/src/main/resources/application.yml
apps/backend/src/main/resources/application.yaml

# Local Spring configuration
application-local.yml
application-local.yaml
application-local.properties

# Local test configuration
application-test-local.yml
application-test-local.yaml
application-test-local.properties


# ============================================================
# DATABASE / LOCAL DATA
# ============================================================

# PostgreSQL local data
postgres-data/
postgres_data/

# Generic database files
*.db
*.sqlite
*.sqlite3

# Database dumps
*.sql.gz
*.dump
*.backup

# IMPORTANT:
# Do NOT ignore migration SQL files.
# Flyway migrations should be committed.


# ============================================================
# DOCKER
# ============================================================

# Docker local override files
docker-compose.override.yml
docker-compose.local.yml

# Docker volumes / local persistent data
docker/volumes/
docker/data/

# Docker logs
docker/*.log
**/docker/*.log


